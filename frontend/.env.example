# Local development API. The backend reads PORT from its own env and defaults
# to 3001 (see backend/index.js) — keep both sides on the same port.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: override the metadataBase host for social previews (defaults to the
# Netlify site in layout.tsx).
# NEXT_PUBLIC_SITE_URL=https://halolhack.netlify.app