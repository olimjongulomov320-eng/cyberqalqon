# Backend configuration. Copy to .env and fill in real values.
# The API starts on 3001 by default; the frontend calls this port locally.

# Postgres connection string (Render injects DATABASE_URL in production)
DATABASE_URL=postgres://user:password@localhost:5432/cyberqalqon

# 30+ random characters — JWT signing secret (Render generates one via render.yaml)
JWT_SECRET=change-me-to-a-long-random-string

# Origin allowed by CORS (Render sets this to the Netlify site in production)
CORS_ORIGIN=http://localhost:3000

# Optional Telegram Web App login (leave empty to disable)
# TELEGRAM_BOT_TOKEN=